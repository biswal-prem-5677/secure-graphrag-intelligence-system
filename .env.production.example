# =============================================================================
# Secure GraphRAG — Production Environment Template (.env.production)
# =============================================================================
# Copy this file to .env in production environments and populate with strong,
# generated secrets. Never commit your production .env to version control!
# =============================================================================

# --- Database & Infrastructure Secrets ---
POSTGRES_USER=graphrag
POSTGRES_DB=secure_graphrag
SECRET_POSTGRES_PASSWORD=replace_with_strong_random_postgres_password_32chars_min
SECRET_REDIS_PASSWORD=replace_with_strong_random_redis_password_32chars_min
SECRET_NEO4J_PASSWORD=replace_with_strong_random_neo4j_password_32chars_min

# --- Application Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_JWT_KEY=replace_with_64_char_cryptographically_secure_jwt_secret_key
DEFAULT_ADMIN_PASSWORD=replace_with_unique_strong_admin_password_16chars_min
DEFAULT_USER_PASSWORD=replace_with_unique_strong_analyst_password_16chars_min

# --- Networking & CORS ---
# Must be your actual production domain (no localhost)
ALLOWED_ORIGINS=https://graphrag.yourdomain.com
NEXT_PUBLIC_API_URL=https://graphrag.yourdomain.com
BACKEND_INTERNAL_URL=http://backend:8000

# --- Stripe Billing (Optional - leave empty or set real production keys) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLED=false

# --- LLM Provider Settings ---
LLM_PROVIDER=mock
# For real cloud providers, set:
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=your_production_google_api_key

# =============================================================================
# Secure GraphRAG Knowledge Intelligence System — Environment Configuration
# =============================================================================
# Copy this file to .env and configure your environment-specific credentials.
# WARNING: NEVER commit active credentials or your actual .env file to Git!
# =============================================================================

# --- Environment & Server ---
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Persistent Relational Database (PostgreSQL / SQLite) ---
# Development/Test default uses local file SQLite: sqlite:///./data/secure_graphrag.db
# Production requires PostgreSQL: postgresql://graphrag:graphrag_secure_2024@localhost:5432/secure_graphrag
DATABASE_URL=sqlite:///./data/secure_graphrag.db
SEED_DEFAULT_USERS=true

# --- LLM Provider Selection ---
# Supported providers: "mock" (offline deterministic default), "gemini", "groq", "ollama", "openai", "multi"
# For zero-credential CI and local testing: LLM_PROVIDER=mock
LLM_PROVIDER=mock

# Google Gemini (Free-tier supported: https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud (Ultra-fast inference: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Local Server (100% Offline & Private: https://ollama.com/)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (Commercial API: https://platform.openai.com/)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Neo4j Graph Database ---
# If Neo4j is offline or unavailable, the system automatically runs with in-memory graph fallback
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_secure_2024

# --- Authentication & Session Security ---
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-64-character-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Default bootstrap users (created during lifespan initialization)
DEFAULT_USER_USERNAME=analyst
DEFAULT_USER_PASSWORD=SecureAnalyst2024!
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=SecureAdmin2024!

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Stripe Billing (Sandbox / Test Mode) ---
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_PRO_PRICE_ID=price_threat_intel_pro_monthly
FREE_TIER_DAILY_LIMIT=10
PRO_TIER_DAILY_LIMIT=200

# --- Cache & Performance ---
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# --- Query Guardrails & Limits ---
MAX_QUERY_LENGTH=1000
MAX_GRAPH_DEPTH=4
MAX_GRAPH_RESULTS=100
QUERY_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=30
